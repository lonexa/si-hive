#!/usr/bin/env bash
# hive-img — POSIX shim that hands off to the Node CLI.
# Companion to hive-img.cmd. Hive prepends this directory to PATH for every
# spawned PTY so agents can invoke the tool via plain `hive-img <path>`.
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
exec node "$DIR/hive-img.cjs" "$@"
